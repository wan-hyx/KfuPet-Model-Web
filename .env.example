# ===== PostgreSQL =====
POSTGRES_DB=kfupet
POSTGRES_USER=kfupet
POSTGRES_PASSWORD=change-me-before-deploy
POSTGRES_PORT=5432

# 本地直跑后端时连接 localhost；Docker Compose 会覆盖为 postgres:5432
DATABASE_URL=postgresql://kfupet:change-me-before-deploy@localhost:5432/kfupet?schema=public

# ===== 后端 =====
PORT=3000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# ===== 存储 =====
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=256
# direct：本地开发由 NestJS 直接发文件；nginx：线上由 Nginx 经 X-Accel-Redirect 发送
DOWNLOAD_MODE=direct

# ===== 种子数据（首次部署建议开启，之后可设为 false） =====
SEED_ON_START=true
SEED_ADMIN_PASSWORD=admin1234
SEED_USER_PASSWORD=demo1234

# ===== Docker Compose =====
HTTP_PORT=80
